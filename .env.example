# Copy to .env and fill in. Never commit .env.

# NVIDIA NIM (build.nvidia.com) key — starts with "nvapi-"
NVIDIA_API_KEY=

# SQLite by default; any SQLAlchemy URL works (e.g. Neon Postgres) for deployment.
DATABASE_URL=sqlite:///./verdict.db

# Optional: if set, the API requires header  X-API-Key: <value>
VERDICT_API_KEY=

# Where the Streamlit UI finds the API
VERDICT_API_URL=http://localhost:8000
